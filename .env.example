# Пример настроек. npm run setup создаёт .env сам, руками обычно ничего менять не нужно.

# База PostgreSQL 16
DATABASE_URL="postgresql://USER@localhost:5432/weekly"

# Ключ подписи сессий: длинная случайная строка, создаётся npm run setup
SESSION_SECRET=""

# Адрес ресурса. Для https cookie помечается как Secure
APP_URL="http://localhost:3000"

# true только за обратным прокси (Caddy на сервере): тогда адрес клиента берётся из X-Forwarded-For
TRUST_PROXY="false"

# Папка с резервными копиями и папка с программами PostgreSQL (pg_dump, pg_restore)
BACKUP_DIR="./backups"
PG_BIN_DIR=""

# Ключ первичной настройки паролей в браузере (страница /setup). Нужен только на сервере до первой настройки
SETUP_TOKEN=""

# Сколько доверенных прокси стоит перед приложением (за App Platform обычно 1)
TRUST_PROXY_HOPS="1"

# false в облаке без постоянного диска: там копии делает управляемая база провайдера
BACKUP_ENABLED="true"

# Домены чужих прокси, с которых разрешена отправка форм, через запятую (для Codespaces: *.app.github.dev)
SERVER_ACTIONS_ALLOWED_ORIGINS=""
