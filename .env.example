# Пример настроек. npm run setup создаёт .env сам, руками обычно ничего менять не нужно.

# База PostgreSQL 16
DATABASE_URL="postgresql://USER@localhost:5432/weekly"

# В облаке вместо DATABASE_URL удобнее части: пароль вставляется как есть.
# DB_SSL: require (по умолчанию) или disable. DB_SSL_ROOT_CERT включает полную проверку сертификата базы
# DB_HOST=""
# DB_PORT="5432"
# DB_USER=""
# DB_NAME=""
# DB_PASSWORD=""
# DB_SSL="require"
# DB_SSL_ROOT_CERT="/app/certs/timeweb-managed-ca.crt"

# Ключ подписи сессий: длинная случайная строка, создаётся npm run setup.
# Если не задан, выводится из пароля базы
SESSION_SECRET=""

# Адрес ресурса. Для https cookie помечается как Secure
APP_URL="http://localhost:3000"

# Этап 69: другие адреса, по которым тоже открывают ресурс (например технический адрес хостинга, пока к приложению
# привязан свой домен), через запятую. С них загрузки файлов не отвечают «Запрос с чужого сайта».
# Только точные адреса http и https: шаблоны со звёздочкой и другие схемы отбрасываются
APP_ALIASES=""
# 1: страницы, открытые не по адресу из APP_URL, уходят постоянным переходом на тот же путь основного адреса.
# /api, загрузки и серверные действия не переводятся. Включать после проверки входа на новом адресе
REDIRECT_TO_APP_URL=""

# true только за обратным прокси (Caddy на сервере): тогда адрес клиента берётся из X-Forwarded-For
TRUST_PROXY="false"

# Папка с резервными копиями и папка с программами PostgreSQL (pg_dump, pg_restore)
BACKUP_DIR="./backups"
PG_BIN_DIR=""

# Ключ первичной настройки паролей в браузере (страница /setup). Необязателен: без него при запуске
# в журнал пишется одноразовый код, пока пароли не заданы
SETUP_TOKEN=""

# Сколько доверенных прокси стоит перед приложением (за App Platform обычно 1)
TRUST_PROXY_HOPS="1"

# false в облаке без постоянного диска: там копии делает управляемая база провайдера
BACKUP_ENABLED="true"

# Домены чужих прокси, с которых разрешена отправка форм, через запятую (для Codespaces: *.app.github.dev)
SERVER_ACTIONS_ALLOWED_ORIGINS=""

# Этап 9: письма со ссылкой для входа и подтверждением режима управления.
# Пока не заданы, письма не уходят, личные ссылки выдаёт владелец в настройках («Ссылка для входа»).
# SMTP_URL: адрес почтового сервера с логином и паролем, например smtps://weekly%40example.ru:ПАРОЛЬ@smtp.example.ru:465
# MAIL_FROM: отправитель, например "Weekly <weekly@example.ru>"
SMTP_URL=""
MAIL_FROM=""
# log: письма пишутся строками в файл MAIL_LOG_FILE вместо отправки (разработка и автотесты)
MAIL_TRANSPORT=""
MAIL_LOG_FILE=".local/mail.log"

# Этап 60: новости по продуктам. Без ключа привязка к продуктам и описания считаются по правилам (ключевые слова).
# С ключом Claude API уточняет привязку и пишет описание в одну-две фразы. Ключ только в переменных окружения.
# ANTHROPIC_API_KEY: ключ API, вставляет владелец аккаунта сам. ANTHROPIC_MODEL: модель, по умолчанию claude-sonnet-5-5
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# 1: ленты читаются из tests/fixtures/news по имени хоста вместо сети (разработка и сквозные тесты).
# При NODE_ENV=production не действует, кроме сквозных тестов: их сервер ставит WEEKLY_E2E=1 (playwright.config.ts)
NEWS_FAKE=""
# MAIL_LOOP=off выключает и цикл писем, и цикл новостей (забор лент, дайджесты новостей, очистка)

# Этап 6 и этап 81: ключ служебного аккаунта Google, весь файл JSON как есть или в base64. Нужен для выгрузки в таблицу
# и для чтения таблиц только на чтение (LRF, хаб, таблица недель и факт для раздела «Неделя к плану»).
# Секрет: вставляет владелец аккаунта сам на сервере, в чат, документы и репозиторий ключ не попадает. Без него ресурс работает.
GOOGLE_SERVICE_ACCOUNT_JSON=""
