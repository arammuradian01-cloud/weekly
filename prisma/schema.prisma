// Схема базы ресурса weekly. Главные данные живут здесь, Google-таблица только зеркалит их (раздел 5 ТЗ).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  LEADER
  OBSERVER
}

enum DictKind {
  DIRECTION
  WEEKLY_BLOCK
  ENTRY_TYPE
  TASK_STATUS
  PRIORITY
  TASK_STATE
  WEEKLY_STATE
  TASK_SOURCE
}

enum ChangeSource {
  APP
  SHEET
  SYSTEM
}

enum AttemptKind {
  TEAM
  MANAGEMENT
}

/// Участник команды. Состав меняет владелец, без разработчика.
model Person {
  id                 String          @id @default(cuid())
  slug               String          @unique
  fullName           String
  shortName          String
  role               Role            @default(LEADER)
  zone               String
  defaultDirectionId String?
  defaultDirection   DictionaryItem? @relation(fields: [defaultDirectionId], references: [id])
  /// Задел на персональные логины (этап 9)
  email              String?         @unique
  active             Boolean         @default(true)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@map("people")
}

/// Все справочники: направления, блоки, типы записей, статусы, приоритеты, состояния.
model DictionaryItem {
  id        String   @id @default(cuid())
  kind      DictKind
  code      String
  label     String
  /// Имя цвета из набора токенов интерфейса (green, blue, yellow, red, gray, outline и т.п.)
  color     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  people    Person[]

  @@unique([kind, code])
  @@map("dictionary_items")
}

/// Настройки: сроки недели, пороги, хэши паролей. Значение хранится как JSON.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

/// Журнал изменений. Только дописывается: правка и удаление запрещены триггером в базе.
model AuditLog {
  id        BigInt       @id @default(autoincrement())
  at        DateTime     @default(now()) @db.Timestamptz(3)
  actorId   String?
  actorName String?
  source    ChangeSource @default(APP)
  action    String
  entity    String?
  entityId  String?
  field     String?
  before    Json?
  after     Json?
  ip        String?

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

/// Попытки входа для блокировки подбора пароля.
model LoginAttempt {
  id      BigInt      @id @default(autoincrement())
  at      DateTime    @default(now()) @db.Timestamptz(3)
  ip      String
  kind    AttemptKind
  ok      Boolean
  blocked Boolean     @default(false)

  @@index([ip, kind, at])
  @@map("login_attempts")
}
