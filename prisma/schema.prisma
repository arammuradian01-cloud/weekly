// Схема базы ресурса weekly. Главные данные живут здесь, Google-таблица только зеркалит их (раздел 5 ТЗ).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  LEADER
  OBSERVER
  /// Сотрудник департамента вне топ-команды (этап 14): ведёт задачи своих команд, weekly пишет по решению руководителя
  EMPLOYEE
}

/// Уровень подразделения в структуре департамента (этап 14)
enum UnitKind {
  DEPARTMENT
  MANAGEMENT
  DIVISION
  SECTOR
  STREAM
  FUNCTION
  EXTERNAL
}

/// TOP: топ-команда директора, состав как сейчас. UNIT: команда руководителя подразделения. CUSTOM: собранная руками
enum TeamKind {
  TOP
  UNIT
  CUSTOM
}

enum DictKind {
  DIRECTION
  WEEKLY_BLOCK
  ENTRY_TYPE
  TASK_STATUS
  PRIORITY
  TASK_STATE
  WEEKLY_STATE
  TASK_SOURCE
}

enum ChangeSource {
  APP
  SHEET
  SYSTEM
}

enum AttemptKind {
  TEAM
  MANAGEMENT
  /// Запрос ссылки для входа на почту
  LINK
  /// Личный логин и пароль (этап 20а)
  PERSONAL
}

/// Как человек вошёл (этап 9): общий логин team, ссылка на почту или ссылка-приглашение от владельца
enum LoginMethod {
  TEAM
  EMAIL
  INVITE
  /// Личный логин и пароль (этап 20а)
  PASSWORD
}

/// Одноразовая ссылка: вход по почте, приглашение от владельца, подтверждение режима управления
enum LinkKind {
  EMAIL
  INVITE
  STEP_UP
}

/// Статусы задач завязаны на правила просрочки (раздел 4 ТЗ), поэтому это перечисление, а не справочник
enum TaskStatus {
  PROPOSED
  IN_PROGRESS
  CLARIFY
  DONE
  /// Выполнена частично (этап 22): задача закрыта, часть результата не будет
  PARTIAL
  FAILED
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskState {
  ON_TRACK
  AT_RISK
  BLOCKED
}

/// Состояние weekly человека за неделю. Нет строки: «Не начат»
enum WeeklyState {
  DRAFT
  SUBMITTED
  LATE
}

/// Участник команды. Состав меняет владелец, без разработчика.
model Person {
  id                  String          @id @default(cuid())
  slug                String          @unique
  fullName            String
  shortName           String
  role                Role            @default(LEADER)
  zone                String
  defaultDirectionId  String?
  defaultDirection    DictionaryItem? @relation(fields: [defaultDirectionId], references: [id])
  /// Почта для личного входа по ссылке (этап 9), в нижнем регистре
  email               String?         @unique
  /// Личный пароль (этап 20а): bcrypt. Задаёт сам человек по ссылке от владельца, владелец только сбрасывает
  passwordHash        String?
  passwordSetAt       DateTime?       @db.Timestamptz(3)
  active              Boolean         @default(true)
  sortOrder           Int             @default(0)
  /// Должность по структуре (этап 14). Кадровые поля не храним
  position            String?
  /// Подразделение по структуре
  unitId              String?
  unit                OrgUnit?        @relation("UnitPeople", fields: [unitId], references: [id], onDelete: SetNull)
  /// Административный руководитель
  managerId           String?
  manager             Person?         @relation("PersonManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// Функциональный руководитель: видит работу человека, но не управляет его задачами
  functionalManagerId String?
  functionalManager   Person?         @relation("PersonFunctionalManager", fields: [functionalManagerId], references: [id], onDelete: SetNull)
  /// Какие письма человек получает (этап 20): { events, mentions, reactions, reminders, digest }. Нет ключа: по умолчанию
  mailPrefs           Json            @default("{}")
  /// Какие уведомления в браузере человек получает (этап 26): { tasks, mentions, reactions }. Нет ключа: по умолчанию
  pushPrefs           Json            @default("{}")
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  reports            Person[]            @relation("PersonManager")
  functionalReports  Person[]            @relation("PersonFunctionalManager")
  headOf             OrgUnit[]           @relation("UnitHead")
  leads              Team[]              @relation("TeamLeader")
  teams              TeamMember[]
  ownedTasks         Task[]              @relation("TaskOwner")
  createdTasks       Task[]              @relation("TaskCreator")
  coTasks            TaskCoExecutor[]
  transfers          TaskTransfer[]
  taskComments       TaskComment[]
  taskLinks          TaskLink[]
  weeks              Week[]
  weeklyReports      WeeklyReport[]
  weeklyEntries      WeeklyEntry[]
  ceoReports         CeoReport[]
  loginLinks         LoginLink[]
  devices            DeviceSession[]
  pushSubscriptions  PushSubscription[]
  absences           Absence[]           @relation("AbsencePerson")
  substitutions      Absence[]           @relation("AbsenceSubstitute")
  inbox              InboxEvent[]        @relation("InboxRecipient")
  promotions         WeeklyPromotion[]
  teamWeekCloses     TeamWeekClose[]
  watches            TaskWatch[]
  ownedGoals         Goal[]              @relation("GoalOwner")
  createdGoals       Goal[]              @relation("GoalCreator")
  entryComments      EntryComment[]
  entryWatches       EntryWatch[]
  reactions          Reaction[]          @relation("ReactionPerson")
  discussed          Reaction[]          @relation("ReactionDiscussedBy")
  mailMarks          MailMark[]
  requestsMade       HelpRequest[]       @relation("RequestAuthor")
  requestsReceived   HelpRequest[]       @relation("RequestAddressee")
  promiseReviews     PromiseReview[]     @relation("PromiseAuthor")
  /// Встреча 2.0 (этап 23)
  meetingsLed        Meeting[]           @relation("MeetingLeader")
  agendaItems        AgendaItem[]        @relation("AgendaPerson")
  agendaDiscussed    AgendaItem[]        @relation("AgendaDiscussedBy")
  decisionsOwned     Decision[]          @relation("DecisionOwner")
  decisionsMade      Decision[]          @relation("DecisionCreator")
  decisionsClosed    Decision[]          @relation("DecisionCanceller")
  /// Поиск, виды и чек-листы (этап 25)
  checklistDone      TaskChecklistItem[]
  savedViews         SavedView[]
  /// Прогноз до конца месяца (этап 24)
  forecasts          Forecast[]
  /// Встречи один на один (этап 28)
  oneOnOneManaged    OneOnOnePair[]      @relation("OneOnOneManager")
  oneOnOneReported   OneOnOnePair[]      @relation("OneOnOneReport")
  oneOnOneTopics     OneOnOneTopic[]     @relation("OneOnOneTopicAuthor")
  oneOnOneNotes      OneOnOneNote[]
  /// Личная ссылка на календарь сроков (этап 29)
  calendarFeed       CalendarFeed?
  /// Кто уже оценил встречи команды (этап 29): без связи с самой оценкой
  meetingRatingVotes MeetingRatingVote[]

  @@map("people")
}

/// Все справочники: направления, блоки, типы записей, статусы, приоритеты, состояния.
model DictionaryItem {
  id                 String        @id @default(cuid())
  kind               DictKind
  code               String
  label              String
  /// Имя цвета из набора токенов интерфейса (green, blue, yellow, red, gray, outline и т.п.)
  color              String?
  sortOrder          Int           @default(0)
  active             Boolean       @default(true)
  isDefault          Boolean       @default(false)
  people             Person[]
  tasks              Task[]
  entriesByDirection WeeklyEntry[] @relation("EntryDirection")
  entriesByBlock     WeeklyEntry[] @relation("EntryBlock")
  entriesByType      WeeklyEntry[] @relation("EntryType")
  forecasts          Forecast[]    @relation("ForecastDirection")

  @@unique([kind, code])
  @@map("dictionary_items")
}

/// Настройки: сроки недели, пороги, хэши паролей. Значение хранится как JSON.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

/// Журнал изменений. Только дописывается: правка и удаление запрещены триггером в базе.
model AuditLog {
  id        BigInt       @id @default(autoincrement())
  at        DateTime     @default(now()) @db.Timestamptz(3)
  actorId   String?
  actorName String?
  source    ChangeSource @default(APP)
  action    String
  entity    String?
  entityId  String?
  field     String?
  before    Json?
  after     Json?
  ip        String?
  /// Как вошёл автор: TEAM (общий логин и выбор профиля), EMAIL или INVITE (личный вход). Пусто: система и таблица
  via       LoginMethod?

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

/// Попытки входа для блокировки подбора пароля.
model LoginAttempt {
  id       BigInt      @id @default(autoincrement())
  at       DateTime    @default(now()) @db.Timestamptz(3)
  ip       String
  kind     AttemptKind
  ok       Boolean
  blocked  Boolean     @default(false)
  /// Чей личный логин пробовали (этап 20а): подбор пароля к одному человеку с разных адресов тоже ограничен
  personId String?
  /// Ключ счётчика личного логина: person:<id> у известного человека (короткое имя и почта считаются вместе),
  /// login:<введённое> у неизвестного. Блокировка одинакова для всех логинов, по ней не узнать, кто есть в ресурсе
  login    String?

  @@index([ip, kind, at])
  @@index([personId, at])
  @@index([login, at])
  @@map("login_attempts")
}

/// Задача (раздел 4 ТЗ). Номер сквозной и не меняется, новые выдаются из настройки tasks.nextNumber.
model Task {
  id             String         @id @default(cuid())
  number         Int            @unique
  /// До 120 знаков, одна мысль
  title          String
  /// Ожидаемый результат: по чему понять, что задача сделана
  outcome        String
  /// null и ownerAll = false: ответственный не назначен
  ownerId        String?
  owner          Person?        @relation("TaskOwner", fields: [ownerId], references: [id])
  /// «Все лидеры»: только для общих задач
  ownerAll       Boolean        @default(false)
  directionId    String
  direction      DictionaryItem @relation(fields: [directionId], references: [id])
  /// null: приоритет не задан (задачи из таблицы, где его нет)
  priority       TaskPriority?
  status         TaskStatus     @default(IN_PROGRESS)
  /// null: состояние не задано (задачи из таблицы)
  state          TaskState?
  /// Чем заблокирована и кто может помочь: при BLOCKED. С этапа 21 пояснение к ссылке на задачу или человека
  blockedBy      String?
  /// Что вернёт задачу в график: обязательно при AT_RISK (этап 21)
  riskNote       String?
  /// «Где сейчас»: одна-две фразы о текущем состоянии
  whereNow       String         @default("")
  whereUpdatedAt DateTime       @db.Date
  due            DateTime       @db.Date
  /// Исходный срок не меняется. null: срок переносили в таблице до запуска ресурса, прежний не записан
  originalDue    DateTime?      @db.Date
  /// Код из справочника TASK_SOURCE: meeting, weekly, ceo, other
  sourceCode     String         @default("other")
  sourceNote     String?
  /// Дата встречи, на которой поставили задачу
  sourceDate     DateTime?      @db.Date
  /// Запись weekly, из которой сделана задача
  weeklyEntryId  String?
  weeklyEntry    WeeklyEntry?   @relation(fields: [weeklyEntryId], references: [id], onDelete: SetNull)
  /// null: задача поставлена на встрече, автор в таблице не записан
  createdById    String?
  createdBy      Person?        @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  closedAt       DateTime?      @db.Timestamptz(3)
  /// Итог для DONE, что сделано и что нет для PARTIAL, причина для FAILED и CANCELLED
  resolution     String?
  archivedAt     DateTime?      @db.Timestamptz(3)
  /// Партия импорта из таблицы, например bord-2026-10-05. Нужна сверке
  importBatch    String?
  /// Команда задачи (этап 14). Всё, что было до команд, принадлежит топ-команде
  teamId         String         @default("top")
  team           Team           @relation(fields: [teamId], references: [id])
  /// Цель, на которую работает задача (этап 17): цель своей команды или команды выше
  goalId         String?
  goal           Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)

  coExecutors    TaskCoExecutor[]
  transfers      TaskTransfer[]
  comments       TaskComment[]
  links          TaskLink[]
  inboxEvents    InboxEvent[]
  watchers       TaskWatch[]
  /// Просьбы по задаче и просьбы, из которых задача сделана (этап 21)
  requests       HelpRequest[]       @relation("RequestTask")
  fromRequests   HelpRequest[]       @relation("RequestResultTask")
  /// Связи задач (этап 21): какие задачи эта ждёт и какие ждут её
  waitsFor       TaskDependency[]    @relation("DependencyTask")
  blocks         TaskDependency[]    @relation("DependencyBlocker")
  /// Встреча 2.0 (этап 23): пункты повестки по задаче и решения, к которым она привязана
  agendaItems    AgendaItem[]
  decisions      DecisionTask[]
  /// Тема встречи один на один, из которой поставлена задача (этап 28)
  oneOnOneTopics OneOnOneTopic[]
  /// Повтор задачи (этап 25): еженедельно или ежемесячно. Следующая создаётся при закрытии или по расписанию в день срока
  repeat         RepeatKind?
  repeatMode     RepeatMode          @default(ON_CLOSE)
  /// Из какой задачи сделан этот повтор. Уникальность: у задачи один следующий повтор
  repeatOfId     String?             @unique
  repeatOf       Task?               @relation("TaskRepeat", fields: [repeatOfId], references: [id], onDelete: SetNull)
  repeatNext     Task?               @relation("TaskRepeat")
  /// Чек-лист внутри задачи (этап 25)
  checklist      TaskChecklistItem[]

  @@index([status])
  @@index([ownerId])
  @@index([teamId])
  @@index([goalId])
  @@map("tasks")
}

/// Повтор задачи (этап 25): еженедельно или ежемесячно
enum RepeatKind {
  WEEKLY
  MONTHLY
}

/// Когда создаётся следующая задача повтора: при закрытии этой или по расписанию в день её срока
enum RepeatMode {
  ON_CLOSE
  SCHEDULE
}

/// Пункт чек-листа внутри задачи (этап 25). Отмечает ответственный, соисполнитель или режим управления
model TaskChecklistItem {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// До 200 знаков
  text      String
  done      Boolean   @default(false)
  doneById  String?
  doneBy    Person?   @relation(fields: [doneById], references: [id])
  doneAt    DateTime? @db.Timestamptz(3)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([taskId, sortOrder])
  @@map("task_checklist_items")
}

/// Сохранённый вид списка (этап 25): фильтры и сортировка из адреса страницы под своим именем, у каждого человека свои
model SavedView {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Раздел, где вид живёт: /tasks
  path      String
  /// До 60 знаков
  name      String
  /// Строка адреса без «?»: f=mine,overdue&sort=due
  query     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([personId, path, name])
  @@map("saved_views")
}

/// Строка недельного отчёта (этап 24): ключ из пяти ячеек, значения по неделям. Снимок перечитывается целиком при каждом заборе,
/// ресурс отчёт только читает
model NumbersRow {
  key       String   @id
  article   String
  iface     String
  product   String
  mapping   String
  comment   String
  /// Порядок строки в отчёте
  ord       Int
  /// Значения по неделям: [{ week: "2026-09-07", value: 504337 }], неделя по понедельнику, null: ячейка пустая
  values    Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([ord])
  @@map("numbers_rows")
}

/// Метрика прогноза: выручка, промо-маржа, прямая маржа в млн руб без НДС, продажи в штуках
enum ForecastMetric {
  REVENUE
  PROMO_MARGIN
  DIRECT_MARGIN
  SALES
}

/// Что поехало: причина отклонения прогноза от бюджета
enum ForecastReason {
  TRAFFIC
  CONVERSION
  CHECK_KV
  PARTNER_SK
  BUDGET_BASE
  OTHER
}

/// Прогноз лидера до конца месяца (этап 24, модуль М9): строка на неделю, линию, метрику и месяц. История по неделям
/// хранится как есть, прошлый прогноз это та же строка за предыдущую неделю
model Forecast {
  id          String          @id @default(cuid())
  weekId      String
  week        Week            @relation(fields: [weekId], references: [id], onDelete: Cascade)
  authorId    String
  author      Person          @relation(fields: [authorId], references: [id])
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  directionId String
  direction   DictionaryItem  @relation("ForecastDirection", fields: [directionId], references: [id])
  metric      ForecastMetric
  /// Месяц прогноза: 2026-10
  month       String
  /// Бюджет месяца из LRF, вводится руками
  budget      Float?
  forecast    Float
  reason      ForecastReason?
  comment     String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([weekId, authorId, directionId, metric, month])
  @@index([month, directionId])
  @@map("forecasts")
}

model TaskCoExecutor {
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([taskId, personId])
  @@map("task_co_executors")
}

/// Перенос срока: с какой даты на какую, кто и почему
model TaskTransfer {
  id      String    @id @default(cuid())
  taskId  String
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// null: прежний срок не записан (перенос в таблице до запуска ресурса)
  fromDue DateTime? @db.Date
  toDue   DateTime  @db.Date
  reason  String
  byId    String?
  by      Person?   @relation(fields: [byId], references: [id])
  /// null: время переноса не записано
  at      DateTime? @db.Timestamptz(3)

  @@index([taskId])
  @@map("task_transfers")
}

/// Комментарий к задаче. Автор правит его 15 минут (этап 20), удаление оставляет след в журнале
model TaskComment {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId    String
  author      Person       @relation(fields: [authorId], references: [id])
  text        String
  source      ChangeSource @default(APP)
  at          DateTime     @default(now()) @db.Timestamptz(3)
  /// Когда автор поправил текст: пометка «изменено»
  editedAt    DateTime?    @db.Timestamptz(3)
  /// id упомянутых людей (этап 20)
  mentions    String[]     @default([])
  inboxEvents InboxEvent[]
  reactions   Reaction[]

  @@index([taskId, at])
  @@map("task_comments")
}

model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  url       String
  addedById String?
  addedBy   Person?  @relation(fields: [addedById], references: [id])
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([taskId])
  @@map("task_links")
}

/// Неделя с понедельника по воскресенье, номер по ISO (раздел 3 ТЗ). Строка создаётся при первом обращении
model Week {
  id          String    @id @default(cuid())
  /// Понедельник недели: ключ, по которому неделю ищут экраны
  start       DateTime  @unique @db.Date
  isoYear     Int
  isoNumber   Int
  /// Срок сдачи weekly: по настройке week.deadline на момент создания недели
  deadline    DateTime  @db.Timestamptz(3)
  meetingDate DateTime  @db.Date
  /// После встречи администратор закрывает неделю: дальше правят только владелец и администраторы
  closedAt    DateTime? @db.Timestamptz(3)
  closedById  String?
  closedBy    Person?   @relation(fields: [closedById], references: [id])

  reports    WeeklyReport[]
  entries    WeeklyEntry[]
  ceoReport  CeoReport?
  absences   Absence[]
  teamCloses TeamWeekClose[]
  promises   PromiseReview[]
  snapshot   WeekSnapshot?
  meetings   Meeting[]
  forecasts  Forecast[]

  @@unique([isoYear, isoNumber])
  @@map("weeks")
}

/// Weekly человека за неделю: главное одной фразой и состояние сдачи
model WeeklyReport {
  id             String      @id @default(cuid())
  weekId         String
  week           Week        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  authorId       String
  author         Person      @relation(fields: [authorId], references: [id])
  headline       String      @default("")
  /// «Спасибо @коллега за…» (этап 22): необязательная строка, попадает в блок отчёта CEO
  thanks         String?
  /// Кто уже получил событие о благодарности: повторно не приходит
  thanksMentions String[]    @default([])
  /// Факты недели, которые человек скрыл: в черновике из фактов больше не предлагаются (этап 22)
  hiddenFacts    String[]    @default([])
  state          WeeklyState @default(DRAFT)
  submittedAt    DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@unique([weekId, authorId])
  @@map("weekly_reports")
}

/// Запись weekly: одно событие (раздел 3 ТЗ)
model WeeklyEntry {
  id          String         @id @default(cuid())
  weekId      String
  week        Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  /// null: общая запись «Все лидеры», автора назначает владелец или администратор
  authorId    String?
  author      Person?        @relation(fields: [authorId], references: [id])
  directionId String
  direction   DictionaryItem @relation("EntryDirection", fields: [directionId], references: [id])
  blockId     String
  block       DictionaryItem @relation("EntryBlock", fields: [blockId], references: [id])
  typeId      String
  type        DictionaryItem @relation("EntryType", fields: [typeId], references: [id])
  /// Что произошло: одна фраза до 150 знаков
  what        String
  details     String?
  impact      String?
  /// «Цифра или факт» из вкладки Weekly CEO
  fact        String?
  next        String?
  /// Какая помощь нужна и от кого. Есть текст: запись поднимается наверх ленты
  help        String?
  /// Ссылки на артефакты: [{ title, url }]
  links       Json           @default("[]")
  ceo         Boolean        @default(false)
  sortOrder   Int            @default(0)
  /// Запись сделана из факта недели (этап 22): closed:52, moved:52:2026-10-20. Факт не предлагается второй раз
  factKey     String?
  /// Ключ черновика с устройства (этап 26): повторная отправка после обрыва связи правит ту же запись, а не создаёт вторую
  clientKey   String?
  importBatch String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  /// id уже упомянутых людей (этап 20), и тех, до кого упоминание не дошло: событие приходит только при первом упоминании
  mentions      String[]          @default([])
  tasks         Task[]
  promotions    WeeklyPromotion[]
  comments      EntryComment[]
  watches       EntryWatch[]
  reactions     Reaction[]
  inbox         InboxEvent[]
  /// Просьба о помощи из записи (этап 21)
  helpRequests  HelpRequest[]
  /// Итог обещания из этой записи (этап 22) и итог, из которого запись перенесена в план
  promiseReview PromiseReview?    @relation("PromiseEntry")
  carriedFrom   PromiseReview?    @relation("PromiseCarried")
  /// Пункты повестки встречи по записи (этап 23)
  agendaItems   AgendaItem[]

  @@unique([weekId, authorId, factKey])
  @@index([weekId, authorId])
  @@map("weekly_entries")
}

/// Черновик отчёта CEO за неделю: видят только владелец и администраторы, в таблицу не выгружается
model CeoReport {
  id          String   @id @default(cuid())
  weekId      String   @unique
  week        Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  main        String   @default("")
  risks       String   @default("")
  next        String   @default("")
  /// «Мои встречи недели» (этап 27): [{ title, text }], по 4-5 предложений на встречу от первого лица
  meetings    Json     @default("[]")
  updatedById String?
  updatedBy   Person?  @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("ceo_reports")
}

/// Очередь отправки в Google-таблицу: что поменялось с прошлой выгрузки. Пишут триггеры базы в той же транзакции,
/// что и правку, поэтому пропустить изменение нельзя. kind: task (номер), comment (id), entry (id), all (*)
model SheetOutbox {
  id   BigInt   @id @default(autoincrement())
  kind String
  key  String
  at   DateTime @default(now()) @db.Timestamptz(3)

  @@index([at])
  @@map("sheet_outbox")
}

/// Прогоны выгрузки, сверки и пересборки: для страницы «Синхронизация» и вкладки «Журнал выгрузки»
model SheetRun {
  id         BigInt    @id @default(autoincrement())
  /// push, reconcile, rebuild
  kind       String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  ok         Boolean   @default(false)
  /// Сколько строк записано или исправлено
  items      Int       @default(0)
  error      String?
  /// Что именно вернула сверка: вкладка, строка, поле, было, стало
  details    Json?

  @@index([kind, startedAt])
  @@map("sheet_runs")
}

/// Одноразовая ссылка (этап 9). В базе только хэш, сама ссылка показывается или уходит письмом один раз
model LoginLink {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  kind        LinkKind
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Кто выдал приглашение
  createdById String?
  /// Ссылка подтверждения режима управления работает только на устройстве, с которого её запросили
  deviceId    String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  usedIp      String?

  @@index([personId, kind])
  @@map("login_links")
}

/// Личный вход на устройстве (этап 9): живёт 30 дней, виден в профиле, завершается «выйти везде»
model DeviceSession {
  id         String             @id @default(cuid())
  personId   String
  person     Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  method     LoginMethod
  userAgent  String?
  ip         String?
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime           @db.Timestamptz(3)
  revokedAt  DateTime?          @db.Timestamptz(3)
  /// Кто завершил: сам человек, владелец, выключение человека
  revokedBy  String?
  push       PushSubscription[]

  @@index([personId])
  @@map("device_sessions")
}

/// «Нет на неделе»: отпуск или отсутствие с замещающим (этап 9)
model Absence {
  id           String   @id @default(cuid())
  personId     String
  person       Person   @relation("AbsencePerson", fields: [personId], references: [id], onDelete: Cascade)
  weekId       String
  week         Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  substituteId String?
  substitute   Person?  @relation("AbsenceSubstitute", fields: [substituteId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([personId, weekId])
  @@index([weekId])
  @@map("absences")
}

/// Что случилось в «Мне» (этап 11): поставили или передали задачу, предложили, добавили соисполнителем, прокомментировали
enum InboxKind {
  TASK_ASSIGNED
  TASK_PROPOSED
  TASK_CONFIRMED
  TASK_COEXECUTOR
  TASK_COMMENT
  TASK_DUE
  /// Руководитель просит обновить задачу: «где сейчас», состояние или срок (этап 16)
  UPDATE_REQUEST
  /// Подписка: у задачи, за которой человек следит, сменился статус или срок (этап 16)
  TASK_WATCH
  /// Упомянули в комментарии или записи weekly (этап 20)
  MENTION
  /// Комментарий к записи weekly: автору записи и подписчикам (этап 20)
  ENTRY_COMMENT
  /// Реакция на запись или комментарий (этап 20)
  REACTION
  /// Просьба коллеги к вам и напоминание о ней (этап 21)
  REQUEST
  /// Ответ на вашу просьбу: принята, отклонена, выполнена, стала задачей (этап 21)
  REQUEST_ANSWER
  /// Связь задач: вашу задачу ждут, задача, которую ждёт ваша, перенесена или закрыта (этап 21)
  TASK_DEPENDENCY
  /// Благодарность в weekly коллеги (этап 22)
  THANKS
  /// Встреча (этап 23): протокол готов, вы владелец решения
  MEETING
  /// Встреча один на один (этап 28): новая тема от второго участника, встреча назначена
  ONE_ON_ONE
}

/// Событие в «Мне» (этап 11). Предмет (subject) склеивает события: одна строка на задачу.
/// «Разобрано» закрывает все события предмета, новое событие возвращает его наверх
model InboxEvent {
  id             String        @id @default(cuid())
  recipientId    String
  recipient      Person        @relation("InboxRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind           InboxKind
  actorId        String?
  actorName      String?
  /// task:47
  subject        String
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId      String?
  comment        TaskComment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  /// Запись weekly и комментарий к ней (этап 20): предмет entry:<id>
  entryId        String?
  entry          WeeklyEntry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryCommentId String?
  entryComment   EntryComment? @relation(fields: [entryCommentId], references: [id], onDelete: Cascade)
  /// Реакция, о которой событие (этап 20): сняли реакцию, и событие о ней уходит вместе с ней
  reactionId     String?
  reaction       Reaction?     @relation(fields: [reactionId], references: [id], onDelete: Cascade)
  /// Просьба (этап 21): предмет request:<номер>
  requestId      String?
  request        HelpRequest?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Коротко, что случилось: «передал вам задачу», «прокомментировал: ...»
  text           String
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  /// «Разобрано»
  doneAt         DateTime?     @db.Timestamptz(3)
  /// «Напомнить»: до этого момента событие скрыто
  snoozeUntil    DateTime?     @db.Timestamptz(3)
  /// Человек видел событие в ресурсе (открыл «Мне» или сам предмет): письмо по нему не нужно (этап 20)
  seenAt         DateTime?     @db.Timestamptz(3)
  /// Письмо по событию ушло или не нужно (выключено в настройках, нет почты)
  mailedAt       DateTime?     @db.Timestamptz(3)
  /// Уведомление в браузере ушло или не нужно (этап 26)
  pushedAt       DateTime?     @db.Timestamptz(3)

  @@index([recipientId, doneAt])
  @@index([recipientId, subject])
  @@index([mailedAt, createdAt])
  @@index([pushedAt, createdAt])
  @@index([entryId])
  @@index([entryCommentId])
  @@index([reactionId])
  @@index([requestId])
  @@map("inbox_events")
}

/// Подразделение департамента (этап 14): дерево от департамента до сектора, направления и функции
model OrgUnit {
  id        String    @id @default(cuid())
  name      String
  kind      UnitKind
  parentId  String?
  parent    OrgUnit?  @relation("UnitTree", fields: [parentId], references: [id], onDelete: NoAction)
  children  OrgUnit[] @relation("UnitTree")
  /// Руководитель подразделения. null: не выделен, пояснение в headNote
  headId    String?
  head      Person?   @relation("UnitHead", fields: [headId], references: [id], onDelete: SetNull)
  /// «Отдельный руководитель не выделен», «Роль делят CPO, PMM и CRM Lead»
  headNote  String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  people    Person[]  @relation("UnitPeople")
  vacancies Vacancy[]
  teams     Team[]

  @@index([parentId])
  @@map("org_units")
}

/// Вакансия: пустое место в подразделении. Видят только руководители этой ветки
model Vacancy {
  id        String    @id @default(cuid())
  unitId    String
  unit      OrgUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  position  String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  closedAt  DateTime? @db.Timestamptz(3)

  @@index([unitId])
  @@map("vacancies")
}

/// Команда руководителя (этап 14). У каждой задачи и weekly есть команда. Топ-команда: id «top»
model Team {
  id                String   @id @default(cuid())
  name              String
  kind              TeamKind @default(UNIT)
  /// Руководитель команды. null: пока не назначен
  leaderId          String?
  leader            Person?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  /// Команда уровнем выше: в неё руководитель сдаёт свой weekly
  parentId          String?
  /// Команду выше поставил владелец руками: загрузка структуры её больше не пересчитывает
  parentManual      Boolean  @default(false)
  parent            Team?    @relation("TeamTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Team[]   @relation("TeamTree")
  /// Подразделение, по которому собрана команда
  unitId            String?
  unit              OrgUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  /// Ритм weekly (этап 15). Срок сдачи: неделя (0 та же отчётная, 1 следующая), день ISO и время по Москве.
  /// Пусто: как у департамента. Позже срока департамента срок команды не бывает
  deadlineWeek      Int?
  deadlineWeekday   Int?
  deadlineTime      String?
  /// Встреча команды: неделя (0 или 1), день и время. Пусто: как у департамента
  meetingWeek       Int?
  meetingWeekday    Int?
  meetingTime       String?
  /// Weekly сдают и специалисты, а не только руководители команд (решение 7: выбирает руководитель команды)
  specialistsWeekly Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  members     TeamMember[]
  tasks       Task[]
  closes      TeamWeekClose[]
  goals       Goal[]
  /// Встречи и решения команды (этап 23)
  meetings    Meeting[]
  decisions   Decision[]
  forecasts   Forecast[]
  /// Анонимная оценка встреч раз в месяц (этап 29)
  ratingVotes MeetingRatingVote[]
  ratings     MeetingRating[]

  @@index([leaderId])
  @@index([parentId])
  @@map("teams")
}

/// Участник команды. Руководитель команды в участниках не числится, он в Team.leaderId
model TeamMember {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  addedById String?
  addedAt   DateTime @default(now()) @db.Timestamptz(3)
  /// Добавлен по структуре как прямой подчинённый руководителя. Такие участники пересчитываются при загрузке структуры,
  /// добавленные руками остаются
  auto      Boolean  @default(false)

  @@id([teamId, personId])
  @@index([personId])
  @@map("team_members")
}

/// Отметка «наверх» (этап 15): руководитель поднимает запись своего человека в свой weekly, в команду уровнем выше.
/// Запись не копируется: та же запись видна в ленте команды выше под его именем, с автором и его фразой
model WeeklyPromotion {
  id        String      @id @default(cuid())
  entryId   String
  entry     WeeklyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  byId      String
  by        Person      @relation(fields: [byId], references: [id], onDelete: Cascade)
  /// Фраза руководителя от себя, до 150 знаков
  note      String?
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([entryId, byId])
  @@index([byId])
  @@map("weekly_promotions")
}

/// Неделя закрыта для команды (этап 15): руководитель разобрал weekly своей команды, дальше её люди не правят.
/// Неделю всего департамента по-прежнему закрывает администратор (weeks.closedAt)
model TeamWeekClose {
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weekId     String
  week       Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  closedAt   DateTime @default(now()) @db.Timestamptz(3)
  closedById String?
  closedBy   Person?  @relation(fields: [closedById], references: [id], onDelete: SetNull)

  @@id([teamId, weekId])
  @@index([weekId])
  @@map("team_week_closes")
}

/// Подписка на задачу (этап 16): человек получает событие в «Мне», когда у задачи меняется статус или срок
model TaskWatch {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, personId])
  @@index([personId])
  @@map("task_watches")
}

/// Итог цели за квартал (этап 17)
enum GoalResult {
  IN_PROGRESS
  ACHIEVED
  PARTIAL
  MISSED
  DROPPED
}

/// Цель квартала (этап 17): дерево от целей департамента (топ-команда) до целей команд и людей.
/// Значения метрик живут в бордах и недельном отчёте: здесь метрика, база и целевое значение текстом и ссылка на борд
model Goal {
  id          String     @id @default(cuid())
  /// Квартал: 2026-Q4
  quarter     String
  /// Номер цели из борда или таблицы («1», «D1», «S4»): по нему загрузка находит цель повторно
  code        String?
  title       String
  description String?
  metric      String?
  base        String?
  target      String?
  /// Команда цели: уровень в дереве. Цели топ-команды это цели департамента
  teamId      String
  team        Team       @relation(fields: [teamId], references: [id])
  /// Владелец цели: руководитель команды или человек, если цель личная
  ownerId     String?
  owner       Person?    @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Goal?      @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]     @relation("GoalTree")
  /// Владелец отметил «в риске» и написал почему
  atRisk      Boolean    @default(false)
  riskNote    String?
  result      GoalResult @default(IN_PROGRESS)
  /// Ссылка на строку в борде лидера
  link        String?
  /// Откуда цель: manual, import, bord:<вкладка>
  source      String     @default("manual")
  sortOrder   Int        @default(0)
  createdById String?
  createdBy   Person?    @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  tasks Task[]

  @@index([quarter, teamId])
  @@index([parentId])
  @@map("goals")
}

/// Комментарий к записи weekly (этап 20): короткая ветка под записью, видна в ленте и в режиме встречи
model EntryComment {
  id          String       @id @default(cuid())
  entryId     String
  entry       WeeklyEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId    String
  author      Person       @relation(fields: [authorId], references: [id])
  text        String
  mentions    String[]     @default([])
  at          DateTime     @default(now()) @db.Timestamptz(3)
  editedAt    DateTime?    @db.Timestamptz(3)
  reactions   Reaction[]
  inboxEvents InboxEvent[]

  @@index([entryId, at])
  @@map("entry_comments")
}

/// Подписка на запись weekly (этап 20): кто прокомментировал или кого упомянули, получает новые комментарии
model EntryWatch {
  entryId   String
  entry     WeeklyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  personId  String
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@id([entryId, personId])
  @@index([personId])
  @@map("entry_watches")
}

/// Реакции: набор фиксированный (этап 20)
enum ReactionKind {
  ACCEPTED
  QUESTION
  DISCUSS
  THANKS
}

/// Реакция на запись weekly, комментарий к записи или комментарий к задаче. Цель ровно одна (проверка в базе).
/// «Обсудить на встрече» требует вопрос, он попадает в повестку встречи, пока его не отметят «обсуждено»
model Reaction {
  id             String        @id @default(cuid())
  kind           ReactionKind
  personId       String
  person         Person        @relation("ReactionPerson", fields: [personId], references: [id], onDelete: Cascade)
  entryId        String?
  entry          WeeklyEntry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryCommentId String?
  entryComment   EntryComment? @relation(fields: [entryCommentId], references: [id], onDelete: Cascade)
  taskCommentId  String?
  taskComment    TaskComment?  @relation(fields: [taskCommentId], references: [id], onDelete: Cascade)
  question       String?
  discussedAt    DateTime?     @db.Timestamptz(3)
  discussedById  String?
  discussedBy    Person?       @relation("ReactionDiscussedBy", fields: [discussedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  inboxEvents    InboxEvent[]

  @@unique([personId, kind, entryId])
  @@unique([personId, kind, entryCommentId])
  @@unique([personId, kind, taskCommentId])
  @@index([entryId])
  @@index([entryCommentId])
  @@index([taskCommentId])
  @@map("reactions")
}

/// Что из писем уже ушло человеку за неделю (этап 20): напоминания о сдаче и дайджест. Не больше двух напоминаний
model MailMark {
  personId String
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Понедельник недели
  week     DateTime @db.Date
  /// remind1, remind2, digest
  kind     String
  sentAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([personId, week, kind])
  @@map("mail_marks")
}

/// Состояние просьбы (этап 21). Пока просьба открыта или принята, следующий шаг за адресатом
enum RequestStatus {
  /// Ждёт ответа адресата
  OPEN
  /// Адресат принял и назвал срок
  ACCEPTED
  DONE
  /// Адресат отклонил с причиной
  DECLINED
  /// Автор отозвал
  WITHDRAWN
}

/// Просьба коллеге (этап 21, модуль М4): от кого, кому, что нужно, к какому сроку, к какой задаче или записи
model HelpRequest {
  id           String        @id @default(cuid())
  /// Номер для ссылок: /requests/12
  number       Int           @unique @default(autoincrement())
  authorId     String
  author       Person        @relation("RequestAuthor", fields: [authorId], references: [id])
  addresseeId  String
  addressee    Person        @relation("RequestAddressee", fields: [addresseeId], references: [id])
  /// Что нужно: одна-две фразы
  text         String
  /// К какому сроку просит автор
  due          DateTime      @db.Date
  /// Срок, который назвал адресат, принимая просьбу
  acceptedDue  DateTime?     @db.Date
  status       RequestStatus @default(OPEN)
  /// Причина отказа или итог выполнения
  answer       String?
  taskId       String?
  task         Task?         @relation("RequestTask", fields: [taskId], references: [id], onDelete: SetNull)
  entryId      String?
  entry        WeeklyEntry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)
  /// Задача адресата, сделанная из просьбы: когда её выполнят, просьба закроется сама
  resultTaskId String?
  resultTask   Task?         @relation("RequestResultTask", fields: [resultTaskId], references: [id], onDelete: SetNull)
  /// Последнее напоминание автора: не чаще раза в сутки
  remindedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  answeredAt   DateTime?     @db.Timestamptz(3)
  closedAt     DateTime?     @db.Timestamptz(3)

  inbox       InboxEvent[]
  /// Пункты повестки встречи по просьбе (этап 23)
  agendaItems AgendaItem[]

  @@index([addresseeId, status])
  @@index([authorId, status])
  @@index([taskId])
  @@index([entryId])
  @@index([resultTaskId])
  @@map("help_requests")
}

/// Связь задач (этап 21, модуль М5): задача task ждёт задачу blocker. Круговых связей нет: это проверяет сервер
model TaskDependency {
  taskId      String
  task        Task     @relation("DependencyTask", fields: [taskId], references: [id], onDelete: Cascade)
  blockerId   String
  blocker     Task     @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  /// Кто связал: id человека, без связи с таблицей людей
  createdById String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([taskId, blockerId])
  @@index([blockerId])
  @@map("task_dependencies")
}

/// Итог обещания (этап 22, модуль М6)
enum PromiseResult {
  DONE
  PARTIAL
  NOT_DONE
  DROPPED
}

/// Итог обещания прошлой недели: план или «что делаем дальше» из прошлого weekly. Лидер ставит его, когда пишет weekly
/// следующей недели, итог хранится в этой неделе: прошлая может быть закрыта, её записи не меняются. Задачи со сроком
/// на неделе сюда не пишутся: их итог это статус самой задачи
model PromiseReview {
  id        String        @id @default(cuid())
  /// Неделя weekly, в котором подведён итог
  weekId    String
  week      Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  authorId  String
  author    Person        @relation("PromiseAuthor", fields: [authorId], references: [id])
  /// Запись прошлой недели. Её удалили: итог остаётся с текстом обещания
  entryId   String?       @unique
  entry     WeeklyEntry?  @relation("PromiseEntry", fields: [entryId], references: [id], onDelete: SetNull)
  /// Что обещал, на момент итога
  what      String
  result    PromiseResult
  note      String?
  /// План этой недели, куда перенесли невыполненное. План удалили: перенести можно снова
  carriedId String?       @unique
  carried   WeeklyEntry?  @relation("PromiseCarried", fields: [carriedId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([weekId, authorId])
  @@map("promise_reviews")
}

/// Снимок недели (этап 22): итоги обещаний топ-команды на момент закрытия недели. Закрытая неделя не меняется,
/// когда потом правят задачи. Неделю открыли снова: снимок удаляется, при закрытии делается заново
model WeekSnapshot {
  id      String   @id @default(cuid())
  weekId  String   @unique
  week    Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  takenAt DateTime @default(now()) @db.Timestamptz(3)
  /// { promises: { people: [{ slug, summary }], total } }
  data    Json

  @@map("week_snapshots")
}

/// Встреча 2.0 (этап 23, модуль М7): встреча команды за неделю. Повестка собирается сама, ведущий ведёт живой режим,
/// решения и поручения остаются в журнале, после закрытия участникам уходит протокол
enum MeetingStatus {
  PLANNED
  LIVE
  DONE
}

model Meeting {
  id             String        @id @default(cuid())
  weekId         String
  week           Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  status         MeetingStatus @default(PLANNED)
  /// Ведущий: кто начал встречу, его экран ведёт остальных
  leaderId       String?
  leader         Person?       @relation("MeetingLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  /// Текущий пункт живого режима
  currentItemId  String?
  startedAt      DateTime?     @db.Timestamptz(3)
  closedAt       DateTime?     @db.Timestamptz(3)
  /// Когда повестка собиралась последний раз
  agendaBuiltAt  DateTime?     @db.Timestamptz(3)
  /// Протокол: текст и момент отправки участникам
  protocol       String?
  protocolSentAt DateTime?     @db.Timestamptz(3)
  /// Ссылка на заметку встречи в Notion
  notionUrl      String?
  /// Таймер на человека, минут
  timerMinutes   Int           @default(7)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  items     AgendaItem[]
  decisions Decision[]

  @@unique([weekId, teamId])
  @@index([teamId, date])
  @@map("meetings")
}

/// Вид пункта повестки. Автоматические собираются из данных, MANUAL добавляет ведущий
enum AgendaKind {
  /// Поручения прошлой встречи: задачи, поставленные на ней, со статусом
  FOLLOW_UP
  /// Просьба без ответа или просроченная
  REQUEST
  /// Задача заблокирована или в риске
  TASK_STATE
  /// Критичная задача или просрочена больше 7 дней
  TASK_ATTENTION
  /// Запись или комментарий с отметкой «обсудить»
  QUESTION
  /// Предложенная задача без ответа
  PROPOSAL
  /// Лидер по очереди: его weekly
  PERSON
  /// Пункт, добавленный руками
  MANUAL
}

model AgendaItem {
  id            String       @id @default(cuid())
  meetingId     String
  meeting       Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind          AgendaKind
  /// Пункт формулируется вопросом
  title         String
  note          String?
  sortOrder     Int          @default(0)
  /// Ключ автоматического пункта: повторная сборка не создаёт его второй раз. У ручных пунктов null
  autoKey       String?
  /// Автоматический пункт убрали из повестки: при пересборке не возвращается
  removedAt     DateTime?    @db.Timestamptz(3)
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entryId       String?
  entry         WeeklyEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  requestId     String?
  request       HelpRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  personId      String?
  person        Person?      @relation("AgendaPerson", fields: [personId], references: [id], onDelete: Cascade)
  /// Реакция «обсудить на встрече», из которой пункт
  reactionId    String?
  discussedAt   DateTime?    @db.Timestamptz(3)
  discussedById String?
  discussedBy   Person?      @relation("AgendaDiscussedBy", fields: [discussedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  decisions Decision[]

  @@unique([meetingId, autoKey])
  @@index([meetingId, sortOrder])
  @@map("agenda_items")
}

enum DecisionStatus {
  ACTIVE
  CANCELLED
}

/// Решение встречи: формулировка, владелец, дата, связанные задачи. «В силе» или «отменено». По решениям работает поиск
model Decision {
  id            String         @id @default(cuid())
  meetingId     String?
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  itemId        String?
  item          AgendaItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  teamId        String
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  text          String
  ownerId       String?
  owner         Person?        @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  date          DateTime       @db.Date
  status        DecisionStatus @default(ACTIVE)
  cancelReason  String?
  cancelledAt   DateTime?      @db.Timestamptz(3)
  cancelledById String?
  cancelledBy   Person?        @relation("DecisionCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     Person?        @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  tasks DecisionTask[]

  @@index([teamId, date])
  @@map("decisions")
}

model DecisionTask {
  decisionId String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([decisionId, taskId])
  @@map("decision_tasks")
}

/// Подписка устройства на уведомления в браузере (этап 26). Живёт, пока жив личный вход на этом устройстве
model PushSubscription {
  id         String        @id @default(cuid())
  personId   String
  person     Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  deviceId   String
  device     DeviceSession @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Адрес службы уведомлений браузера: у каждого устройства свой
  endpoint   String        @unique
  p256dh     String
  auth       String
  /// «Chrome на Android»: чтобы человек узнал устройство в профиле
  label      String?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  lastSentAt DateTime?     @db.Timestamptz(3)
  /// Подряд неудачных отправок: после десяти подписка удаляется
  failures   Int           @default(0)

  @@index([personId])
  @@map("push_subscriptions")
}

/// Встречи один на один (этап 28): руководитель и человек его команды. Видят только эти двое и только при личном входе:
/// ни режим управления, ни общий логин, ни журнал содержимое не показывают
enum OneOnOneStatus {
  PLANNED
  DONE
}

enum OneOnOneTopicStatus {
  OPEN
  DISCUSSED
  DROPPED
}

/// Пара «руководитель и человек». Темы живут у пары: незакрытая тема переходит на следующую встречу сама
model OneOnOnePair {
  id        String   @id @default(cuid())
  managerId String
  manager   Person   @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  reportId  String
  report    Person   @relation("OneOnOneReport", fields: [reportId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  meetings OneOnOne[]
  topics   OneOnOneTopic[]

  @@unique([managerId, reportId])
  @@index([reportId])
  @@map("one_on_one_pairs")
}

/// Встреча пары. Запланированная у пары одна (уникальный индекс в миграции)
model OneOnOne {
  id         String         @id @default(cuid())
  pairId     String
  pair       OneOnOnePair   @relation(fields: [pairId], references: [id], onDelete: Cascade)
  date       DateTime       @db.Date
  status     OneOnOneStatus @default(PLANNED)
  /// Общие заметки: видят оба участника
  notes      String         @default("")
  closedAt   DateTime?      @db.Timestamptz(3)
  closedById String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  topics       OneOnOneTopic[]
  privateNotes OneOnOneNote[]

  @@index([pairId, date])
  @@map("one_on_ones")
}

/// Тема встречи: кто поставил, итог обсуждения, задача из темы
model OneOnOneTopic {
  id        String              @id @default(cuid())
  pairId    String
  pair      OneOnOnePair        @relation(fields: [pairId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Person?             @relation("OneOnOneTopicAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  status    OneOnOneTopicStatus @default(OPEN)
  /// Итог: о чём договорились
  outcome   String?
  /// Встреча, на которой тему обсудили или сняли
  meetingId String?
  meeting   OneOnOne?           @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  closedAt  DateTime?           @db.Timestamptz(3)

  @@index([pairId, status])
  @@index([meetingId])
  @@index([taskId])
  @@map("one_on_one_topics")
}

/// Личная заметка к встрече: видит только автор
model OneOnOneNote {
  id        String   @id @default(cuid())
  meetingId String
  meeting   OneOnOne @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String   @default("")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([meetingId, authorId])
  @@map("one_on_one_notes")
}

/// Личная ссылка на календарь сроков (этап 29): подписка в Google, Яндекс или Outlook. Хранится только отпечаток
/// ссылки, саму ссылку видно один раз при создании. У человека одна ссылка: новая заменяет прежнюю
model CalendarFeed {
  id         String    @id @default(cuid())
  personId   String    @unique
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  /// Названия задач и имена в календаре. По умолчанию выключены: сервис календаря хранит всё у себя
  withTitles Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// Когда календарь последний раз забирал данные (не чаще раза в 15 минут)
  lastUsedAt DateTime? @db.Timestamptz(3)

  @@map("calendar_feeds")
}

/// Кто уже оценил встречи команды за месяц (этап 29). Отдельно от оценок и без времени: по базе не связать человека
/// с ответом. Ключ случайный, не по времени
model MeetingRatingVote {
  id       String @id @default(uuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Месяц вида 2026-10
  month    String
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, month, personId])
  @@map("meeting_rating_votes")
}

/// Анонимная оценка встреч команды за месяц: полезность от 1 до 5 и что убрать. Без автора и без времени
model MeetingRating {
  id     String @id @default(uuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  month  String
  score  Int
  /// Что убрать из встреч: одна-две фразы, можно пусто
  remove String @default("")

  @@index([teamId, month])
  @@map("meeting_ratings")
}
