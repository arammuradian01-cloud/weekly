// Схема базы ресурса weekly. Главные данные живут здесь, Google-таблица только зеркалит их (раздел 5 ТЗ).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  LEADER
  OBSERVER
}

enum DictKind {
  DIRECTION
  WEEKLY_BLOCK
  ENTRY_TYPE
  TASK_STATUS
  PRIORITY
  TASK_STATE
  WEEKLY_STATE
  TASK_SOURCE
}

enum ChangeSource {
  APP
  SHEET
  SYSTEM
}

enum AttemptKind {
  TEAM
  MANAGEMENT
}

/// Статусы задач завязаны на правила просрочки (раздел 4 ТЗ), поэтому это перечисление, а не справочник
enum TaskStatus {
  PROPOSED
  IN_PROGRESS
  CLARIFY
  DONE
  FAILED
  CANCELLED
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskState {
  ON_TRACK
  AT_RISK
  BLOCKED
}

/// Участник команды. Состав меняет владелец, без разработчика.
model Person {
  id                 String          @id @default(cuid())
  slug               String          @unique
  fullName           String
  shortName          String
  role               Role            @default(LEADER)
  zone               String
  defaultDirectionId String?
  defaultDirection   DictionaryItem? @relation(fields: [defaultDirectionId], references: [id])
  /// Задел на персональные логины (этап 9)
  email              String?         @unique
  active             Boolean         @default(true)
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  ownedTasks   Task[]           @relation("TaskOwner")
  createdTasks Task[]           @relation("TaskCreator")
  coTasks      TaskCoExecutor[]
  transfers    TaskTransfer[]
  taskComments TaskComment[]
  taskLinks    TaskLink[]

  @@map("people")
}

/// Все справочники: направления, блоки, типы записей, статусы, приоритеты, состояния.
model DictionaryItem {
  id        String   @id @default(cuid())
  kind      DictKind
  code      String
  label     String
  /// Имя цвета из набора токенов интерфейса (green, blue, yellow, red, gray, outline и т.п.)
  color     String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  people    Person[]
  tasks     Task[]

  @@unique([kind, code])
  @@map("dictionary_items")
}

/// Настройки: сроки недели, пороги, хэши паролей. Значение хранится как JSON.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("settings")
}

/// Журнал изменений. Только дописывается: правка и удаление запрещены триггером в базе.
model AuditLog {
  id        BigInt       @id @default(autoincrement())
  at        DateTime     @default(now()) @db.Timestamptz(3)
  actorId   String?
  actorName String?
  source    ChangeSource @default(APP)
  action    String
  entity    String?
  entityId  String?
  field     String?
  before    Json?
  after     Json?
  ip        String?

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

/// Попытки входа для блокировки подбора пароля.
model LoginAttempt {
  id      BigInt      @id @default(autoincrement())
  at      DateTime    @default(now()) @db.Timestamptz(3)
  ip      String
  kind    AttemptKind
  ok      Boolean
  blocked Boolean     @default(false)

  @@index([ip, kind, at])
  @@map("login_attempts")
}

/// Задача (раздел 4 ТЗ). Номер сквозной и не меняется, новые выдаются из настройки tasks.nextNumber.
model Task {
  id             String         @id @default(cuid())
  number         Int            @unique
  /// До 120 знаков, одна мысль
  title          String
  /// Ожидаемый результат: по чему понять, что задача сделана
  outcome        String
  /// null и ownerAll = false: ответственный не назначен
  ownerId        String?
  owner          Person?        @relation("TaskOwner", fields: [ownerId], references: [id])
  /// «Все лидеры»: только для общих задач
  ownerAll       Boolean        @default(false)
  directionId    String
  direction      DictionaryItem @relation(fields: [directionId], references: [id])
  /// null: приоритет не задан (задачи из таблицы, где его нет)
  priority       TaskPriority?
  status         TaskStatus     @default(IN_PROGRESS)
  /// null: состояние не задано (задачи из таблицы)
  state          TaskState?
  /// Чем заблокирована и кто может помочь: обязательно при BLOCKED
  blockedBy      String?
  /// «Где сейчас»: одна-две фразы о текущем состоянии
  whereNow       String         @default("")
  whereUpdatedAt DateTime       @db.Date
  due            DateTime       @db.Date
  /// Исходный срок не меняется. null: срок переносили в таблице до запуска ресурса, прежний не записан
  originalDue    DateTime?      @db.Date
  /// Код из справочника TASK_SOURCE: meeting, weekly, ceo, other
  sourceCode     String         @default("other")
  sourceNote     String?
  /// Дата встречи, на которой поставили задачу
  sourceDate     DateTime?      @db.Date
  /// Запись weekly, из которой сделана задача (этап 4)
  weeklyEntryId  String?
  /// null: задача поставлена на встрече, автор в таблице не записан
  createdById    String?
  createdBy      Person?        @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  closedAt       DateTime?      @db.Timestamptz(3)
  /// Итог для DONE, причина для FAILED и CANCELLED
  resolution     String?
  archivedAt     DateTime?      @db.Timestamptz(3)
  /// Партия импорта из таблицы, например bord-2026-10-05. Нужна сверке
  importBatch    String?

  coExecutors TaskCoExecutor[]
  transfers   TaskTransfer[]
  comments    TaskComment[]
  links       TaskLink[]

  @@index([status])
  @@index([ownerId])
  @@map("tasks")
}

model TaskCoExecutor {
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id])

  @@id([taskId, personId])
  @@map("task_co_executors")
}

/// Перенос срока: с какой даты на какую, кто и почему
model TaskTransfer {
  id      String    @id @default(cuid())
  taskId  String
  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// null: прежний срок не записан (перенос в таблице до запуска ресурса)
  fromDue DateTime? @db.Date
  toDue   DateTime  @db.Date
  reason  String
  byId    String?
  by      Person?   @relation(fields: [byId], references: [id])
  /// null: время переноса не записано
  at      DateTime? @db.Timestamptz(3)

  @@index([taskId])
  @@map("task_transfers")
}

/// Комментарии не затираются: только добавляются
model TaskComment {
  id       String       @id @default(cuid())
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   Person       @relation(fields: [authorId], references: [id])
  text     String
  source   ChangeSource @default(APP)
  at       DateTime     @default(now()) @db.Timestamptz(3)

  @@index([taskId, at])
  @@map("task_comments")
}

model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  url       String
  addedById String?
  addedBy   Person?  @relation(fields: [addedById], references: [id])
  at        DateTime @default(now()) @db.Timestamptz(3)

  @@index([taskId])
  @@map("task_links")
}
