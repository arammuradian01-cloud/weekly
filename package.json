{
  "name": "weekly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Weekly и задачи команды «Страхование и инвестиции»",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx scripts/worker.ts",
    "local": "concurrently -k -n web,worker -c blue,green \"npm:start\" \"npm:worker\"",
    "setup": "tsx scripts/setup.ts",
    "password": "tsx scripts/set-password.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:check": "tsx scripts/restore-check.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "up": "npm run build && npm run local",
    "import:bord": "tsx scripts/import-bord.ts",
    "import:bord-weekly": "tsx scripts/import-bord-weekly.ts",
    "reconcile:bord": "tsx scripts/reconcile-bord.ts",
    "reload:bord": "tsx scripts/reload-bord.ts",
    "login-link": "tsx scripts/login-link.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "prisma": "7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
